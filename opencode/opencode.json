{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@dietrichgebert/ponytail",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "npm *", "effect": "allow" },
    { "action": "shell", "resource": "npm install *", "effect": "ask" },
    { "action": "shell", "resource": "uv *", "effect": "allow" },
    { "action": "shell", "resource": "uv add *", "effect": "ask" },
    { "action": "shell", "resource": "poetry *", "effect": "allow" },
    { "action": "shell", "resource": "poetry add *", "effect": "ask" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "env", "effect": "deny" },
    { "action": "shell", "resource": "env *", "effect": "deny" },
    { "action": "shell", "resource": "printenv", "effect": "deny" },
    { "action": "shell", "resource": "printenv *", "effect": "deny" },
    { "action": "shell", "resource": "export", "effect": "deny" },
    { "action": "shell", "resource": "alembic upgrade head", "effect": "ask" },
    { "action": "shell", "resource": "kubetcl get secret*", "effect": "deny" },
    { "action": "shell", "resource": "kubetcl describe secret*", "effect": "deny" },
    { "action": "shell", "resource": "kubetcl get externalsecret*", "effect": "deny" },
    { "action": "shell", "resource": "kubetcl describe externalsecret*", "effect": "deny" },
    { "action": "shell", "resource": "kubectl get secret*", "effect": "deny" },
    { "action": "shell", "resource": "kubectl describe secret*", "effect": "deny" },
    { "action": "shell", "resource": "kubectl get externalsecret*", "effect": "deny" },
    { "action": "shell", "resource": "kubectl describe externalsecret*", "effect": "deny" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.settings.local.toml", "effect": "deny" },
    { "action": "read", "resource": "**/settings.local.toml", "effect": "deny" },
    { "action": "read", "resource": ".secrets.toml", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": ".npmrc", "effect": "deny" },
    { "action": "read", "resource": ".netrc", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "*.pfx", "effect": "deny" },
    { "action": "read", "resource": "**/credentials.json", "effect": "deny" },
    { "action": "read", "resource": "**/auth.json", "effect": "deny" },
    { "action": "read", "resource": ".bash_history", "effect": "deny" },
    { "action": "read", "resource": ".zsh_history", "effect": "deny" },
    { "action": "read", "resource": "**/.aws/credentials", "effect": "deny" },
    { "action": "read", "resource": "**/.docker/config.json", "effect": "deny" },
    { "action": "read", "resource": "**/id_rsa", "effect": "deny" },
    { "action": "read", "resource": "**/id_ed25519", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/Documents/te-proto-contracts/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Documents/te-backend/scr/py/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Documents/subsystem-backend/**", "effect": "allow" }
  ]
}
